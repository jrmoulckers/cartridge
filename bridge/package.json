{
  "name": "cartridge-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless metadata bridge for Cartridge. Looks up game metadata from IGDB and caches it in KV. Never stores a user's library.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
