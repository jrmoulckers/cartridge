# Local development only. Copy to `.dev.vars` and fill in your own values.
#
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is git-ignored and must never be committed. In production these are set with
# `wrangler secret put TWITCH_CLIENT_ID` / `wrangler secret put TWITCH_CLIENT_SECRET`.
#
# Both values come from a Twitch application (IGDB's API is authenticated through Twitch):
# https://dev.twitch.tv/console/apps — see README.md for the walkthrough.

TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"

# Steam Web API key, from https://steamcommunity.com/dev/apikey — see README.md.
# Used per request to broker Steam calls; never stored next to anything identifying a user.
STEAM_API_KEY="your-steam-web-api-key"

ALLOWED_ORIGINS="http://localhost:5173"
