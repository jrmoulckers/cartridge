{
  "name": "cartridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck": "npm run check",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "vendor:check": "node scripts/vendor-configs.mjs --check",
    "vendor:check:offline": "node scripts/vendor-configs.mjs --check --no-remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@jrmoulckers/eslint-config": ">=0.10.0 <0.11.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.13.2",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "idb": "^8.0.4"
  }
}
