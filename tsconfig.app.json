{
  "extends": "@jrmoulckers/tsconfig/vite-app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    /* Svelte's ambient types, and `.svelte` imports are checked by svelte-check
       rather than tsc, so plain JS in the app is not type-checked here. */
    "types": ["svelte", "vite/client"],
    "checkJs": false,
    "paths": {
      "@jrm/tokens/*": ["./vendor/@jrm/tokens/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
